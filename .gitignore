# Dependencies
node_modules/

# Configuration (contains sensitive data)
config.json

# Data files (user-specific — 全部不提交)
data/characters/
data/character_overrides/
data/worldbooks/
data/worlds/
data/chats/
data/sessions/
data/backups/
data/restore-backups/
data/range-corpus.json
data/range-prefs.json
data/range-embeddings.json
data/range-sync-history.json
data/range-snapshots/
data/presets/
data/kb_*.json
# OJ 反馈轮询的游标（本地运行态；丢了会导致重启后要么重发历史、要么漏通知）
data/oj-feedback-state.json
data/oj-feedback-state.json.tmp
data/range_*.json
data/test_*.txt
data/*_result.txt

# Keep data directory structure
!data/.gitkeep

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
logs/
*.log
npm-debug.log*

# Local workspaces and temporary artifacts
.worktrees/
tmp/
goal-*/
compare-ui/
claude-script-check.js
todo.txt

# Audio files (generated TTS)
audio/

# Local session notes and implementation process docs
SESSION_HANDOFF.txt
docs/superpowers/

# Environment
.env
.env.local

# Claude Code project settings (contains MCP config)
.claude/
.mcp.json
issues.txt

# Temp script artifacts
tmp-bracket-check.py
tmp-part.js
tmp_prompt_range_*.txt
tmp-*.py

# Local backup files produced while patching (never publish)
*.bak-*
*.bak_*
*.orig
*.rej

# Local runtime state: sticker library (~114 MB), inbox, oj state, ...
# Only the .gitkeep that holds the directory open is tracked.
data/*
!data/.gitkeep

# Throwaway artifacts (underscore = one-off, workspace convention): never publish
_*
