# Normalise line endings so a clone on any platform behaves the same.
* text=auto

# Shell / config / source must stay LF or they break on Linux clones.
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.go    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
Dockerfile text eol=lf

# Windows launchers want CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.zip   binary
